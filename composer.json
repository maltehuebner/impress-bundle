{
    "name": "maltehuebner/impress-bundle",
    "description": "Keep your impress up to date",
    "type": "library",
    "require": {
        "php": "^8.3",
        "twig/twig": "^3.0",
        "symfony/cache": "^5.4|^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^5.4|^6.4|^7.0|^8.0",
        "symfony/config": "^5.4|^6.4|^7.0|^8.0",
        "symfony/serializer": "^5.4|^6.4|^7.0|^8.0",
        "symfony/property-access": "^5.4|^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Malte Huebner",
            "email": "malte@caldera.cc"
        }
    ],
    "autoload": {
        "psr-4": {
            "MalteHuebner\\ImpressBundle\\Tests\\": "tests",
            "MalteHuebner\\ImpressBundle\\": "src"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests"
    },
    "extra": {
        "symfony": {
            "require": ">=5.4"
        }
    }
}
